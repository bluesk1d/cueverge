CUEVERGE_ASSET_ROOT=C:\Cueverge\assets
# Keep awake, player mode, display, audio device/delay and telemetry rate below are host
# defaults: administrators can override them per device in Device details > Agent settings.
CUEVERGE_MPV_EXECUTABLE=C:\Tools\mpv\mpv.exe
# Optional protocol-v2 authenticated presence. These must be configured together.
# CUEVERGE_DEVICE_TRANSPORT_URL=wss://controller-host:7443/api/device/v2/agent/ws
# CUEVERGE_DEVICE_CREDENTIAL_ROOT=C:\Users\operator\.config\cueverge\device-v2
# CUEVERGE_MPV_PIPE=\\.\pipe\cueverge-mpv
# Set only after checking mpv --audio-device=help and the Windows display layout.
# CUEVERGE_FULLSCREEN_SCREEN=1
# CUEVERGE_AUDIO_DEVICE=wasapi/...
# Positive values delay audio relative to video; negative values advance it.
# CUEVERGE_AUDIO_DELAY_MS=0
# always: start mpv with the agent. on_demand: keep only the controller connection
# running; the controller starts mpv for a show and stops it after it is idle.
# CUEVERGE_PLAYER_MODE=always
# Keep the host awake while the agent runs. off (default) leaves the operating system's
# power settings alone; system blocks automatic sleep; display also blocks screen blanking.
# CUEVERGE_KEEP_AWAKE=display
# Controller-managed installs (cueverge-agent-install) live here; the launcher sets it for the agent.
# CUEVERGE_AGENT_HOME=
