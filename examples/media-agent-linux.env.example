CUEVERGE_AGENT_ID=second-projector
CUEVERGE_CONTROLLER_URL=ws://controller-host:8000/api/v1/agent/ws
CUEVERGE_ASSET_ROOT=/srv/cueverge/assets
CUEVERGE_MPV_EXECUTABLE=/usr/bin/mpv
# CUEVERGE_MPV_PIPE=/tmp/cueverge-mpv.sock
# Set only after checking the Linux display layout and mpv output behavior.
# CUEVERGE_FULLSCREEN_SCREEN=0
# CUEVERGE_AUDIO_DEVICE=alsa/...
# Positive values delay audio relative to video; negative values advance it.
# CUEVERGE_AUDIO_DELAY_MS=0
