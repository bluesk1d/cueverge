CUEVERGE_SHOW_PACKAGE=shows/demo
# Delays rendered lighting relative to authoritative media time.
# CUEVERGE_LIGHTING_DELAY_MS=0

# Hardware output is opt-in. Leave disabled until host, pixel count, channel
# order, ownership, and restoration are validated.
CUEVERGE_DDP_ENABLED=false
# CUEVERGE_DDP_HOST=192.0.2.1
# CUEVERGE_DDP_PORT=4048
# CUEVERGE_DDP_PIXEL_COUNT=605
# Optional artistic output scale. The default is 1.0 (unscaled).
# CUEVERGE_DDP_BRIGHTNESS_LIMIT=1.0

# For multiple lighting resources, use a private deployment file instead of
# the legacy CUEVERGE_DDP_* settings. Do not commit the populated file.
# CUEVERGE_OUTPUT_CONFIG=C:\Cueverge\private\outputs.json

# Browser GUI is disabled unless explicitly enabled. Generate the password hash
# with: uv run cueverge-gui-hash-password
# CUEVERGE_GUI_ENABLED=true
# CUEVERGE_GUI_DATA_ROOT=/srv/cueverge/gui
# CUEVERGE_GUI_ADMIN_USERNAME=admin
# CUEVERGE_GUI_ADMIN_PASSWORD_HASH=scrypt$...
# CUEVERGE_GUI_ALLOWED_ORIGINS=https://cueverge.example.test
# CUEVERGE_GUI_SECURE_COOKIES=true
# Optional Vite production build served by the controller.
# CUEVERGE_GUI_WEB_ROOT=/srv/cueverge/web/dist
# Managed asset upload limits.
# CUEVERGE_GUI_ASSET_MAX_BYTES=10000000000
# CUEVERGE_GUI_ASSET_STORE_QUOTA_BYTES=100000000000
# CUEVERGE_GUI_ASSET_CHUNK_MAX_BYTES=8388608

# With GUI enabled and no CUEVERGE_FRIGATE_* variables, camera input setup is
# available in Installation > Inputs & connections, initially off. GUI-managed
# credentials use protected controller-local storage (POSIX owner-only access).
# Explicit GUI mode ignores Frigate environment settings instead of mixing them:
# CUEVERGE_INPUT_MANAGEMENT=gui
#
# Alternatively retain read-only operator/environment management. Restart after
# changing these values; broker connectivity is not proof of visitor reception.
# Do not enable against a real broker until event-triggered responses are authorized.
# CUEVERGE_INPUT_MANAGEMENT=environment
# CUEVERGE_FRIGATE_MQTT_ENABLED=false
# CUEVERGE_FRIGATE_MQTT_HOST=mqtt.example.test
# CUEVERGE_FRIGATE_MQTT_PORT=8883
# CUEVERGE_FRIGATE_MQTT_TLS=true
# CUEVERGE_FRIGATE_MQTT_TOPIC=frigate/events
# CUEVERGE_FRIGATE_ACCEPTED_LABELS=person
# CUEVERGE_FRIGATE_MQTT_USERNAME=cueverge
# Supply CUEVERGE_FRIGATE_MQTT_PASSWORD only through private operator configuration.

# Protocol-v2 certificate enrollment is separately disabled by default. Enable
# it only after verified TLS termination is in place. The CA password protects
# the installation CA private key at rest and must come from private deployment
# configuration, never source control.
# CUEVERGE_DEVICE_ENROLLMENT_ENABLED=true
# CUEVERGE_DEVICE_ENROLLMENT_TLS_TERMINATED=true
# CUEVERGE_DEVICE_CA_KEY_PASSWORD=replace-with-a-long-random-secret

# The authenticated protocol-v2 listener is a separate mTLS-only port. Each
# configured identity is written into its server certificate SAN. Devices must
# connect using one of these exact DNS names or IP addresses.
# CUEVERGE_DEVICE_LISTENER_ENABLED=true
# CUEVERGE_DEVICE_LISTENER_HOST=0.0.0.0
# CUEVERGE_DEVICE_LISTENER_PORT=7443
# CUEVERGE_DEVICE_LISTENER_IDENTITIES=cueverge.example.test,192.0.2.10
# Exact URL devices use after enrollment. It must match a listener certificate
# identity and use wss.
# CUEVERGE_DEVICE_LISTENER_PUBLIC_URL=wss://192.0.2.10:7443/api/device/v2/agent/ws
